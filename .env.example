# Envío de notificaciones por email (ver services/email.js), vía la API HTTP
# de Brevo (https://www.brevo.com; free tier: 300 emails/día sin tarjeta) y
# no por SMTP: muchas redes de instituciones bloquean los puertos SMTP
# salientes, pero HTTPS (443) casi siempre pasa.
# La API key se genera en Brevo > Settings > SMTP & API > API Keys.
# BREVO_FROM_EMAIL tiene que ser un remitente verificado en esa cuenta de Brevo.
BREVO_API_KEY=tu_api_key_de_brevo
BREVO_FROM_EMAIL=no-responder@tudominio.com
BREVO_FROM_NAME=Gestión de Libros

# URL donde corre el frontend (Vite). Se usa para armar el link de
# "crear tu contraseña" que se manda en el email de invitación.
FRONTEND_URL=http://localhost:5173